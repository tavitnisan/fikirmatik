# Copy to .env and fill in from your provider's "Connect" / "SSH" panel.
# RunPod: "SSH over exposed TCP"  ->  ssh root@<POD_HOST> -p <POD_PORT>
# Vast:   "Direct ssh connect"    ->  ssh -p <POD_PORT> root@<POD_HOST>
POD_HOST=
POD_PORT=
POD_USER=root
SSH_KEY=~/.ssh/gpu_rental_ed25519

# Model to download and work on (any HF id; must be an unquantized BF16 checkpoint for baking).
# The default is the abliterated Qwen3.8-27B this kit was built around: it answers directly instead
# of refusing. Swap in Qwen/Qwen3.8-27B for the stock model, or any other HF chat model.
MODEL=tavitnisanyan/fikirmatik

# Optional: what fikirmatik.ai offers to start (HF id or a folder on the pod; default: MODEL),
# and the name chat shows for it (default: the model's folder name).
# SERVE_MODEL=
# SERVE_NAME=

# Optional, RunPod only: lets fikirmatik.ai start and stop the pod itself. RUNPOD_API_KEY is easiest
# to add from the app (Settings, Pod); any pod on RUNPOD_VOLUME_ID (a network volume) can serve, and
# fikirmatik.ai keeps RUNPOD_POD_ID pointing at the last one it started.
# RUNPOD_API_KEY=
# RUNPOD_VOLUME_ID=
# RUNPOD_POD_ID=

# Optional default system prompt for ./gpu.sh chat and fikirmatik.ai.
# CHAT_SYSTEM="You are a concise, direct assistant."
